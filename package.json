{
  "name": "ndcc-snail-race",
  "version": "5.7.0",
  "private": true,
  "description": "Snail Racing fundraiser for sports clubs - live race stage, Stripe donations and moderator console. One codebase, one profile per club (clubs/<id>).",
  "scripts": {
    "predev": "node scripts/club.mjs use && node scripts/audio-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/club.mjs use && node scripts/audio-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "prelint": "node scripts/club.mjs use",
    "lint": "eslint .",
    "pretypecheck": "node scripts/club.mjs use",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/club.mjs use",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:cloudflare": "node --experimental-strip-types cloudflare/test/contract-probe.ts",
    "pretest:e2e": "node scripts/club.mjs use",
    "test:e2e": "playwright test",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh",
    "test:release": "npm run typecheck && npm run lint && npm test && npm run test:cloudflare && npm run test:e2e",
    "club": "node scripts/club.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
