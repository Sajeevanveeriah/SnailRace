{
  "name": "ndcc-snail-race",
  "version": "4.1.0",
  "private": true,
  "description": "Snail Racing Fundraiser for the Newcomb & District Cricket Club - live race stage, Stripe donations and moderator console.",
  "scripts": {
    "predev": "node scripts/audio-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/audio-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:release": "npm run typecheck && npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "next": "^16.3.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
