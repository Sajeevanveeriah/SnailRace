# ── Stripe ────────────────────────────────────────────────────────────────
# The only variable the app truly needs. Without it the stage still runs and
# cash donations still record; the card feed reports "Cash only".
# Test key: sk_test_...   Live key: sk_live_...
STRIPE_SECRET_KEY=

# Optional. Speeds up how fast a completed payment appears on the board by
# clearing the cached snapshot. The board is correct without it.
# Create at https://dashboard.stripe.com/webhooks pointing to
#   https://<your-domain>/api/stripe/webhook
# listening for checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Optional. Only used to build absolute Stripe return URLs when the request
# does not carry an Origin header. Vercel supplies one automatically.
NEXT_PUBLIC_SITE_URL=
